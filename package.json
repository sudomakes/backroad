{
  "name": "backroad-monorepo",
  "version": "1.13.2",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "build-demo": "pnpm --filter backroad-frontend run build && pnpm --filter @backroad-examples/demo run build && shx rm -rf dist/examples/demo/public && shx cp -R dist/libs/backroad-frontend dist/examples/demo/public",
    "dev": "cross-env BACKROAD_ENV=dev pnpm --parallel --filter @backroad-examples/demo --filter backroad-frontend run dev",
    "d": "$npm_execpath dev",
    "hook-help": "$npm_execpath exec node .lefthook/hook-help.mjs",
    "lint": "pnpm -r --if-present run lint",
    "pre-commit-check": "$npm_execpath exec node .lefthook/pre-commit/run.mjs --manual",
    "pre-push-check": "$npm_execpath exec node .lefthook/pre-push/run.mjs --manual",
    "prepare": "lefthook install",
    "release": "node tools/scripts/release.mjs",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "e2e": "playwright test",
    "e2e:docs": "playwright test --config=e2e/docs/playwright.config.ts",
    "e2e:install": "playwright install --with-deps chromium",
    "knip": "knip",
    "knip:ci": "node tools/scripts/knip-check.mjs",
    "knip:baseline": "node tools/scripts/knip-check.mjs --write",
    "size": "pnpm --filter backroad-frontend run build && size-limit",
    "size:why": "size-limit --why",
    "storybook": "pnpm --filter backroad-frontend run storybook",
    "sb": "pnpm --filter backroad-frontend run storybook",
    "storybook:build": "pnpm --filter backroad-frontend run storybook:build",
    "docs": "pnpm --filter @backroad-examples/docs run dev",
    "docs:build": "pnpm --filter @backroad-examples/docs run build",
    "docs:serve": "pnpm --filter @backroad-examples/docs run build-and-serve",
    "landing": "pnpm --filter @backroad-examples/landing run dev",
    "landing:build": "pnpm --filter @backroad-examples/landing run build",
    "site:build": "pnpm --filter @backroad-examples/landing run build && pnpm --filter @backroad-examples/docs run build"
  },
  "private": true,
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@commitlint/cli": "^17.8.1",
    "@commitlint/config-conventional": "^17.8.1",
    "@playwright/test": "^1.60.0",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^11.1.0",
    "@semantic-release/exec": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/release-notes-generator": "^12.1.0",
    "@size-limit/file": "^12.1.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.1",
    "@testing-library/react": "14.0.0",
    "@types/express": "4.17.13",
    "@types/lodash": "^4.17.24",
    "@types/node": "^20.19.43",
    "@types/react": "18.2.14",
    "@types/react-dom": "18.2.6",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "@vitejs/plugin-react": "^5.2.0",
    "conventional-changelog-conventionalcommits": "^7.0.2",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.12",
    "eslint": "~8.46.0",
    "eslint-config-prettier": "8.1.0",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-jsx-a11y": "6.7.1",
    "eslint-plugin-react": "7.32.2",
    "eslint-plugin-react-hooks": "4.6.0",
    "jsdom": "~22.1.0",
    "knip": "^6.16.1",
    "lefthook": "^2.1.9",
    "postcss": "^8.5.15",
    "prettier": "^2.8.8",
    "sass": "^1.101.0",
    "semantic-release": "^23.1.1",
    "shx": "^0.3.4",
    "size-limit": "^12.1.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "vite": "^6.4.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.8"
  },
  "dependencies": {
    "@faker-js/faker": "^8.4.1",
    "@heroicons/react": "^2.2.0",
    "@swc/helpers": "0.5.2",
    "@tanstack/react-table": "^8.21.3",
    "@types/formidable": "^3.5.1",
    "@types/react-helmet": "^6.1.11",
    "chart.js": "^4.5.1",
    "chartjs-plugin-autocolors": "^0.2.2",
    "express": "^4.22.2",
    "fast-json-stable-stringify": "^2.1.0",
    "formidable": "^3.5.4",
    "lodash": "^4.18.1",
    "minimatch": "^9.0.9",
    "react": "18.2.0",
    "react-accessible-accordion": "^5.0.1",
    "react-chartjs-2": "^5.3.1",
    "react-colorful": "^5.7.0",
    "react-dom": "18.2.0",
    "react-dropzone": "^14.4.1",
    "react-ga4": "^2.1.0",
    "react-helmet": "^6.1.0",
    "react-json-view": "^1.21.3",
    "react-markdown": "^9.1.0",
    "react-router-dom": "^6.30.4",
    "react-select": "^5.10.2",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "superjson": "^1.13.3",
    "tslib": "^2.8.1"
  }
}
