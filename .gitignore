# See http://help.github.com/ignore-files/ for more about ignoring files.

# ── Dependencies ─────────────────────────────────────────────────────────
node_modules
.pnpm-store

# ── Build / cache output ─────────────────────────────────────────────────
dist
tmp
/out-tsc
.cache
.turbo
.nx
.next
.vite
.docusaurus
apps/docs/build
*.tsbuildinfo
coverage
/.sass-cache

# ── Test artifacts ───────────────────────────────────────────────────────
# Playwright HTML report + per-test screenshots/traces/videos.
playwright-report/
test-results/
# Vitest UI / Storybook test-runner snapshot diffs.
__screenshots__/

# ── Secrets / local state ────────────────────────────────────────────────
# All env files except committable templates.
.env
.env.*
!.env.example
!.env.sample
# Local SQLite databases (better-auth dev DB, etc.).
*.sqlite
*.sqlite-journal
*.db
# Backup / temporary copies.
.npmrc.bak
*.bak

# ── Docker / deploy artifacts ────────────────────────────────────────────
# Image tarballs from `docker save` / `docker build --output=type=docker`.
*.tar
*.tar.gz

# ── IDE + editor state ───────────────────────────────────────────────────
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# ── Per-user dev tool state ──────────────────────────────────────────────
.gstack/

# ── Logs ─────────────────────────────────────────────────────────────────
*.log
npm-debug.log
yarn-error.log
testem.log
/connect.lock
/libpeerconnection.log
/typings

# ── OS files ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
e2e/.auth/

.sandcastle