{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "tools/scripts/*.mjs",
        "playwright.config.ts",
        "e2e/**/*.spec.ts"
      ],
      "project": ["tools/scripts/**/*.mjs", "e2e/**/*.ts"]
    },
    "examples/demo": {
      "entry": ["src/main.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/landing": {
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "libs/backroad-frontend": {
      "entry": [
        "src/main.tsx",
        "vite.config.ts",
        ".storybook/main.{js,ts}",
        ".storybook/preview.{js,ts}",
        "src/**/*.stories.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "libs/backroad": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "libs/backroad-core": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "libs/backroad-components": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "libs/backroad-ui": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  },
  "ignoreBinaries": ["lefthook"],
  "ignoreDependencies": [
    "@ai-hero/sandcastle",
    "docusaurus-lunr-search",
    "lunr",
    "@docusaurus/plugin-content-docs",
    "tailwindcss",
    "@tailwindcss/typography",
    "tw-animate-css",
    "postcss"
  ]
}
